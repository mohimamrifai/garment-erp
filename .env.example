# ==== Database ====
# Dev lokal via `docker compose up -d` (host port 5435, lihat docker-compose.yml)
DATABASE_URL="postgresql://garment:garment@localhost:5435/garment_erp"
# Database terpisah untuk integration/e2e test
DATABASE_URL_TEST="postgresql://garment:garment@localhost:5435/garment_erp_test"

# ==== Better Auth ====
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL aplikasi (dipakai Better Auth untuk callback & cookie)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==== Demo ====
# "1" = tampilkan tombol masuk cepat akun demo di halaman login.
# Biarkan kosong untuk deployment non-demo (tombol disembunyikan).
NEXT_PUBLIC_DEMO_MODE="1"

# ==== Asisten AI (Ollama Cloud) ====
# Buat API key di https://ollama.com/settings/keys. Hanya untuk server —
# jangan memakai prefix NEXT_PUBLIC_.
API_KEY_OLLAMA=""
OLLAMA_BASE_URL="https://ollama.com"
# Model ringan/cepat: 20B total, 3.6B parameter aktif, mendukung tool calling.
OLLAMA_MODEL="gpt-oss:20b"
